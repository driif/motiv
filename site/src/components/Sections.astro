---
import { catalog, categories } from '../catalog.mjs';
import Section from './Section.astro';

interface Props {
  style: 'drawn' | 'matrix' | 'kinetic';
}

const { style } = Astro.props;
const sections = catalog[style];
const groups = [
  ...categories.map((category) => ({
    title: category,
    ids: sections.filter((s) => s.category === category).map((s) => s.id),
  })),
  { title: `Only in ${style}`, ids: sections.filter((s) => s.category === null).map((s) => s.id) },
].filter(({ ids }) => ids.length);
---

<div class="site-sections">
  {
    groups.map(({ title, ids }) => (
      <div class="site-category">
        <h2 class="site-kicker">{title}</h2>
        {ids.map((id) => (
          <Section style={style} id={id} />
        ))}
      </div>
    ))
  }
</div>
