---
import drawnCss from '@driif/motiv/drawn.css?url';
import matrixCss from '@driif/motiv/matrix.css?url';
import kineticCss from '@driif/motiv/styles.css?url';

interface Props {
  title: string;
  style?: 'kinetic' | 'matrix' | 'drawn';
  showcase?: boolean;
}

const { title, style = 'kinetic', showcase = false } = Astro.props;
const css = { kinetic: kineticCss, matrix: matrixCss, drawn: drawnCss }[style];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href={css} />
    <base href={`/${style}/`} target="_parent" />
    <title>{title} preview · motiv</title>
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('motiv-site-theme');
        } catch {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <style is:inline>
      body {
        margin: 0;
        padding: 1rem;
        box-sizing: border-box;
        background: var(--motiv-color-bg);
        color: var(--motiv-color-text);
        font-family: var(--motiv-font-body);
      }

      .preview-demo {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.25rem;
      }

      .site-release {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap: 1.25rem;
      }

      .site-release__lead {
        grid-column: 1 / -1;
      }

      @media (max-width: 32rem) {
        .site-release .motiv-card__footer {
          flex-wrap: wrap;
        }
      }

      .site-app {
        display: grid;
        grid-template-columns: 13rem minmax(0, 1fr);
        grid-template-areas:
          "bar bar"
          "nav main";
        gap: 1.25rem 2rem;
        padding: clamp(1rem, 3vw, 2rem);
        border: 1px solid var(--motiv-color-border);
        border-radius: var(--motiv-radius-lg);
        background: var(--motiv-color-surface);
      }

      .site-app__bar {
        grid-area: bar;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .site-app__brand {
        margin-right: auto;
        font-family: "Caveat", "Segoe Print", cursive;
        font-size: 1.9rem;
        font-weight: 400;
        line-height: 1;
      }

      .site-app__nav {
        grid-area: nav;
        display: grid;
        align-content: start;
        gap: 0.25rem;
      }

      .site-app__main {
        grid-area: main;
        min-width: 0;
      }

      .site-app__progress {
        margin-bottom: 1.5rem;
      }

      .site-app__panel {
        display: grid;
        gap: 1.25rem;
        max-width: 28rem;
        padding-top: 1.25rem;
      }

      .site-app__note {
        margin: 0;
      }

      @media (min-width: 48rem) {
        .site-app__menu {
          display: none;
        }
      }

      @media (max-width: 47.99rem) {
        .site-app {
          grid-template-columns: minmax(0, 1fr);
          grid-template-areas:
            "bar"
            "nav"
            "main";
        }

        .site-app[data-menu="false"] .site-app__nav {
          display: none;
        }
      }

      .site-console {
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        grid-template-areas:
          "bar bar"
          "nav main";
        gap: 1.25rem 2rem;
        padding: 0.5rem;
      }

      .site-console__bar {
        grid-area: bar;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .site-console__brand {
        margin-right: auto;
        color: var(--motiv-color-primary);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .site-console__nav {
        grid-area: nav;
      }

      .site-console__main {
        grid-area: main;
        min-width: 0;
      }

      .site-console__panel {
        display: grid;
        gap: 1.5rem;
        max-width: 28rem;
        padding-top: 1.25rem;
      }

      .site-console__note {
        margin: 0;
      }

      @media (min-width: 48rem) {
        .site-console__menu {
          display: none;
        }
      }

      @media (max-width: 47.99rem) {
        .site-console {
          grid-template-columns: minmax(0, 1fr);
          grid-template-areas:
            "bar"
            "nav"
            "main";
        }

        .site-console[data-menu="false"] .site-console__nav {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main class:list={{ 'preview-demo': !showcase }}><slot /></main>
    <script>
      addEventListener('storage', (event) => {
        if (event.key === 'motiv-site-theme' && (event.newValue === 'dark' || event.newValue === 'light')) {
          document.documentElement.dataset.theme = event.newValue;
        }
      });

      const reportHeight = () => {
        parent.postMessage(
          { type: 'motiv-preview-height', height: Math.ceil(document.body.getBoundingClientRect().height) },
          location.origin,
        );
      };
      new ResizeObserver(reportHeight).observe(document.body);
      reportHeight();
    </script>
  </body>
</html>
