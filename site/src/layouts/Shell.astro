---
import '@driif/motiv/styles.css';
import pkg from '@driif/motiv/package.json';
import { catalog } from '../catalog.mjs';
import { ThemeToggleDemo } from '../demos/kinetic/ThemeToggle';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  current?: 'drawn' | 'matrix' | 'kinetic';
}

const { title, description, current } = Astro.props;
const styles = ['drawn', 'matrix', 'kinetic'] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('motiv-site-theme');
        } catch {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="site-body">
    <header class="site-top">
      <a class="site-top__mark" href="/">
        motiv <span class="site-top__version">v{pkg.version}</span>
      </a>
      <nav class="site-switch" aria-label="Style">
        {
          styles.map((style) => (
            <a
              class="site-switch__link"
              href={`/${style}/`}
              aria-current={style === current ? 'page' : undefined}
              data-anchors={catalog[style].map((section) => section.id).join(' ')}
            >
              {style}
            </a>
          ))
        }
      </nav>
      <ThemeToggleDemo client:load />
    </header>
    <div class="site-page" data-style={current}>
      <main class="site-main">
        <slot />
      </main>
    </div>
    <footer class="site-foot">
      <span>@driif/motiv v{pkg.version} · MIT</span>
      <a class="site-foot__link" href="https://github.com/driif/motiv">GitHub</a>
      <a class="site-foot__link" href="https://www.npmjs.com/package/@driif/motiv">npm</a>
    </footer>
    <script>
      // Point each style link at the section in view when that style documents it too.
      const links = document.querySelectorAll<HTMLAnchorElement>('.site-switch__link');
      const follow = (id: string) => {
        for (const link of links) {
          link.hash = link.dataset.anchors?.split(' ').includes(id) ? id : '';
        }
      };
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) if (entry.isIntersecting) follow(entry.target.id);
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      for (const section of document.querySelectorAll('.site-section')) observer.observe(section);
      follow(location.hash.slice(1));

      const frames = document.querySelectorAll<HTMLIFrameElement>('.site-preview');
      for (const frame of frames) {
        const syncHeight = () => {
          const height = frame.contentDocument?.body?.getBoundingClientRect().height;
          if (height) frame.style.height = `${Math.ceil(height)}px`;
        };
        frame.addEventListener('load', syncHeight);
        syncHeight();
      }

      addEventListener('message', (event) => {
        if (event.origin !== location.origin || event.data?.type !== 'motiv-preview-height') return;
        if (!Number.isFinite(event.data.height) || event.data.height <= 0) return;
        for (const frame of frames) {
          if (frame.contentWindow === event.source) frame.style.height = `${event.data.height}px`;
        }
      });
    </script>
  </body>
</html>
