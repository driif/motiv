---
import { Code } from 'astro:components';
import Section from '../../components/Section.astro';
import Shell from '../../layouts/Shell.astro';
import settingsSource from '../../showcase/DrawnSettings.tsx?raw';
import themeSource from '../../useTheme.ts?raw';

const first = `import '@driif/motiv/drawn.css';
import { Button, TextField } from '@driif/motiv/drawn';

export function Subscribe() {
  return (
    <form>
      <TextField label="Email" type="email" hint="We only use it to reply." />
      <Button type="submit">Subscribe</Button>
    </form>
  );
}`;
---

<Shell
  current="drawn"
  title="drawn · motiv"
  description="The drawn style of @driif/motiv: React components that look sketched by hand."
>
  <section class="site-hero">
    <p class="site-kicker">drawn</p>
    <h1 class="site-hero__title">Lightweight components, drawn style.</h1>
    <p class="site-hero__lede">Pencil lines and ink ticks over native inputs.</p>
  </section>

  <section class="site-usecase" id="settings" aria-label="Use case: a settings screen">
    <iframe class="site-preview" src="/preview/drawn/settings/" title="Settings screen preview" />
    <details class="site-source">
      <summary class="site-source__summary">Source</summary>
      <Code class="site-code" code={settingsSource} lang="tsx" theme="github-dark-dimmed" />
    </details>
  </section>

  <section class="site-start" id="getting-started">
    <h2 class="site-start__title">Getting started</h2>
    <ol class="site-steps">
      <li class="site-steps__item">
        <h3 class="site-steps__title">Install</h3>
        <p class="site-steps__text">Peers: React 19, react-dom.</p>
        <Code class="site-code" code="pnpm add @driif/motiv" lang="sh" theme="github-dark-dimmed" />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Import the stylesheet</h3>
        <p class="site-steps__text">Tokens, base and the Caveat font. Replaces <code class="site-inline">styles.css</code>.</p>
        <Code
          class="site-code"
          code="import '@driif/motiv/drawn.css';"
          lang="ts"
          theme="github-dark-dimmed"
        />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Use</h3>
        <p class="site-steps__text">Named exports, no provider.</p>
        <Code class="site-code" code={first} lang="tsx" theme="github-dark-dimmed" />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Theme</h3>
        <p class="site-steps__text">Your app sets <code class="site-inline">data-theme</code> on <code class="site-inline">&lt;html&gt;</code>.</p>
        <Code class="site-code" code={themeSource} lang="ts" theme="github-dark-dimmed" />
      </li>
    </ol>
  </section>

  <div class="site-sections">
    <Section style="drawn" id="button" />
    <Section style="drawn" id="ink-splatter-button" />
    <Section style="drawn" id="hold-to-confirm-button" />
    <Section style="drawn" id="card" />
    <Section style="drawn" id="text-field" />
    <Section style="drawn" id="textarea" />
    <Section style="drawn" id="checkbox" />
    <Section style="drawn" id="switch" />
    <Section style="drawn" id="slider" />
    <Section style="drawn" id="radio" />
    <Section style="drawn" id="select" />
    <Section style="drawn" id="segmented-control" />
    <Section style="drawn" id="tabs" />
    <Section style="drawn" id="link" />
    <Section style="drawn" id="nav-item" />
    <Section style="drawn" id="icon-button" />
    <Section style="drawn" id="menu-button" />
    <Section style="drawn" id="tooltip" />
    <Section style="drawn" id="progress" />
    <Section style="drawn" id="theme-toggle" />
    <Section style="drawn" id="orbital-theme-toggle" />
  </div>
</Shell>
