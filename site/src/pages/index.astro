---
import { buttonClassName, Card, CardFooter, CardHeader } from '@driif/motiv';
import { catalog } from '../catalog.mjs';
import Shell from '../layouts/Shell.astro';

const styles = [
  { id: 'kinetic', pitch: 'The default. Quiet, minimal, soft springs.' },
  { id: 'drawn', pitch: 'Lightweight components, drawn by hand.' },
  { id: 'matrix', pitch: 'Phosphor terminal for consoles and dashboards.' },
] as const;
---

<Shell
  title="motiv · UI/UX components"
  description="@driif/motiv: React components with plain, themeable CSS, in three styles: kinetic, drawn and matrix."
>
  <section class="site-hero">
    <h1 class="site-hero__title">motiv — UI/UX components</h1>
    <p class="site-hero__lede">
      Plain CSS, server-render safe, no provider. Components grouped by style for a quick
      bootstrap.
    </p>
  </section>
  <ul class="site-choose">
    {
      styles.map((style) => (
        <Card as="li" className="site-choose__card" data-style={style.id}>
          <CardHeader titleAs="h2" title={style.id} description={style.pitch} />
          <CardFooter>
            <a class={buttonClassName({ variant: 'outline', size: 'sm' })} href={`/${style.id}/`}>
              {catalog[style.id].length} components
            </a>
          </CardFooter>
        </Card>
      ))
    }
  </ul>
</Shell>
