---
import { Code } from 'astro:components';
import Section from '../../components/Section.astro';
import Shell from '../../layouts/Shell.astro';
import releaseSource from '../../showcase/MotivRelease.tsx?raw';

const first = `import '@driif/motiv/styles.css';
import { Button, Card, CardBody, CardHeader, cx } from '@driif/motiv';

export function Welcome({ compact = false }) {
  return (
    <Card className={cx('welcome', compact && 'welcome--compact')}>
      <CardHeader title="Welcome back" />
      <CardBody>
        <Button>Continue</Button>
      </CardBody>
    </Card>
  );
}`;

const retheme = `:root {
  --motiv-color-primary: #2563eb;
  --motiv-color-on-primary: #ffffff;
  --motiv-radius: 0.25rem;
}`;
---

<Shell
  current="kinetic"
  title="kinetic · motiv"
  description="kinetic, the default style of @driif/motiv: lilac surfaces, fine outlines and soft springs that only move transform and opacity."
>
  <section class="site-hero">
    <p class="site-kicker">kinetic · default</p>
    <h1 class="site-hero__title">Quiet, minimal components.</h1>
    <p class="site-hero__lede">Fine outlines and soft springs. Motion only moves transform and opacity.</p>
  </section>

  <section class="site-usecase" id="release" aria-label="Use case: a release screen">
    <iframe
      class="site-preview"
      src="/preview/kinetic/release/"
      title="Release screen preview"
    />
    <details class="site-source">
      <summary class="site-source__summary">Source</summary>
      <Code class="site-code" code={releaseSource} lang="tsx" theme="github-dark-dimmed" />
    </details>
  </section>

  <section class="site-start" id="getting-started">
    <h2 class="site-start__title">Getting started</h2>
    <ol class="site-steps">
      <li class="site-steps__item">
        <h3 class="site-steps__title">Install</h3>
        <p class="site-steps__text">Peers: React 19, react-dom.</p>
        <Code class="site-code" code="pnpm add @driif/motiv" lang="sh" theme="github-dark-dimmed" />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Import the stylesheet</h3>
        <p class="site-steps__text">Add <code class="site-inline">base.css</code> for a minimal reset.</p>
        <Code
          class="site-code"
          code="import '@driif/motiv/styles.css';"
          lang="ts"
          theme="github-dark-dimmed"
        />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Use</h3>
        <p class="site-steps__text">Named exports, no provider. <code class="site-inline">cx</code> joins class names.</p>
        <Code class="site-code" code={first} lang="tsx" theme="github-dark-dimmed" />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Re-theme</h3>
        <p class="site-steps__text">Everything is in <code class="site-inline">@layer motiv.*</code>; your rules win.</p>
        <Code class="site-code" code={retheme} lang="css" theme="github-dark-dimmed" />
      </li>
    </ol>
  </section>

  <div class="site-sections">
    <Section style="kinetic" id="button" />
    <Section style="kinetic" id="magnetic-button" />
    <Section style="kinetic" id="morph-submit-button" />
    <Section style="kinetic" id="bell-button" />
    <Section style="kinetic" id="badge-button" />
    <Section style="kinetic" id="copy-field" />
    <Section style="kinetic" id="radial-menu" />
    <Section style="kinetic" id="icon-button" />
    <Section style="kinetic" id="menu-button" />
    <Section style="kinetic" id="theme-toggle" />
    <Section style="kinetic" id="segmented-control" />
    <Section style="kinetic" id="elastic-tabs" />
    <Section style="kinetic" id="filter-chips" />
    <Section style="kinetic" id="radio" />
    <Section style="kinetic" id="stepper" />
    <Section style="kinetic" id="command-menu" />
    <Section style="kinetic" id="floating-field" />
    <Section style="kinetic" id="otp-input" />
    <Section style="kinetic" id="expanding-search" />
    <Section style="kinetic" id="frequency-slider" />
    <Section style="kinetic" id="momentum-slider" />
    <Section style="kinetic" id="liquid-switch" />
    <Section style="kinetic" id="spring-checkbox" />
    <Section style="kinetic" id="like-button" />
    <Section style="kinetic" id="mute-toggle" />
    <Section style="kinetic" id="card" />
    <Section style="kinetic" id="slip-card" />
    <Section style="kinetic" id="accordion" />
    <Section style="kinetic" id="carousel" />
    <Section style="kinetic" id="glide-nav" />
    <Section style="kinetic" id="step-progress" />
    <Section style="kinetic" id="drill-stack" />
    <Section style="kinetic" id="progress-ring" />
    <Section style="kinetic" id="odometer" />
  </div>
</Shell>
