---
import { Code } from 'astro:components';
import Sections from '../../components/Sections.astro';
import Shell from '../../layouts/Shell.astro';
import consoleSource from '../../showcase/MatrixConsole.tsx?raw';
import themeSource from '../../useTheme.ts?raw';

const first = `import '@driif/motiv/matrix.css';
import { DecodeSecretField, ScanButton } from '@driif/motiv/matrix';
import { useState } from 'react';

export function Unseal() {
  const [key, setKey] = useState('');
  return (
    <form>
      <DecodeSecretField label="Unseal key" value={key} onChange={setKey} />
      <ScanButton type="submit">Unseal</ScanButton>
    </form>
  );
}`;
---

<Shell
  current="matrix"
  title="matrix · motiv"
  description="The matrix style of @driif/motiv: React components for consoles and dashboards, in phosphor green on a terminal grid."
>
  <section class="site-hero">
    <p class="site-kicker">matrix</p>
    <h1 class="site-hero__title">Terminal components for consoles.</h1>
    <p class="site-hero__lede">Phosphor green, monospace, square corners.</p>
  </section>

  <section class="site-usecase" id="console" aria-label="Use case: a vault console">
    <iframe class="site-preview" src="/preview/matrix/console/" title="Vault console preview" />
    <details class="site-source">
      <summary class="site-source__summary">Source</summary>
      <Code class="site-code" code={consoleSource} lang="tsx" theme="github-dark-dimmed" />
    </details>
  </section>

  <section class="site-playground" id="playground">
    <h2 class="site-playground__title">Playground</h2>
    <p class="site-playground__text">Change a token and every matrix component follows. Paste the CSS into your app.</p>
    <iframe class="site-preview" src="/preview/matrix/playground/" title="Token playground preview" />
  </section>

  <section class="site-start" id="getting-started">
    <h2 class="site-start__title">Getting started</h2>
    <ol class="site-steps">
      <li class="site-steps__item">
        <h3 class="site-steps__title">Install</h3>
        <p class="site-steps__text">Peers: React 19, react-dom.</p>
        <Code class="site-code" code="pnpm add @driif/motiv" lang="sh" theme="github-dark-dimmed" />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Import the stylesheet</h3>
        <p class="site-steps__text">Tokens, base and the monospace stack. Replaces <code class="site-inline">styles.css</code>.</p>
        <Code
          class="site-code"
          code="import '@driif/motiv/matrix.css';"
          lang="ts"
          theme="github-dark-dimmed"
        />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Use</h3>
        <p class="site-steps__text">Named exports, no provider. Same props as the drawn twins.</p>
        <Code class="site-code" code={first} lang="tsx" theme="github-dark-dimmed" />
      </li>
      <li class="site-steps__item">
        <h3 class="site-steps__title">Theme</h3>
        <p class="site-steps__text">Your app sets <code class="site-inline">data-theme</code> on <code class="site-inline">&lt;html&gt;</code>.</p>
        <Code class="site-code" code={themeSource} lang="ts" theme="github-dark-dimmed" />
      </li>
    </ol>
  </section>

  <Sections style="matrix" />
</Shell>
