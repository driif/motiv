---
import { Link } from '@driif/motiv/drawn';
import Shell from '../../layouts/Shell.astro';
---

<Shell
  current="matrix"
  title="matrix · motiv"
  description="matrix, an upcoming style of @driif/motiv, is still being drawn up."
>
  <section class="site-hero">
    <p class="site-kicker">Style 02 · matrix</p>
    <h1 class="site-hero__title">Still being drawn up.</h1>
    <p class="site-hero__lede">
      matrix is an upcoming style of motiv. It has no released components yet, so there is nothing
      here to copy. When the first one ships, it lands on this page with a live demo, the same day
      it reaches npm.
    </p>
    <div class="site-grid" aria-hidden="true">
      {Array.from({ length: 48 }, (_, index) => <span class="site-grid__cell" style={`--i: ${index}`} />)}
    </div>
    <p class="site-hero__lede">
      Until then, the <Link href="/drawn/" arrow={false}>drawn</Link> and
      <Link href="/kinetic/" arrow={false}>kinetic</Link> styles are ready to use.
    </p>
  </section>
</Shell>
